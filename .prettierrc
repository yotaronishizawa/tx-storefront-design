{
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrderParserPlugins": ["typescript", "jsx"],
  "importOrder": [
    "^(react/(.*)$)|^(react$)",
    "",
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^#",
    "",
    "^~/(.*)$",
    "",
    "^[./]"
  ],
  "tailwindStylesheet": "app/app.css",
  "tailwindFunctions": ["cn", "cva"]
}
